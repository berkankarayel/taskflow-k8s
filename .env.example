# Copy to .env and adjust. Never commit the real .env file.

# --- Application ---
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- Behaviour ---
CACHE_TTL_SECONDS=30
ACTIVITY_RETENTION_DAYS=7
